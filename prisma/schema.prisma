generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Status, source and activity type are stored as strings so the schema stays
// portable to Postgres; allowed values live in src/lib/constants.ts.
model Lead {
  id         String     @id @default(cuid())
  name       String
  company    String?
  email      String?    @unique
  phone      String?
  status     String     @default("NEW")
  source     String     @default("OTHER")
  value      Int?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]

  @@index([status])
  @@index([source])
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}
